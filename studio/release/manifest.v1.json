{
  "schema_version": 1,
  "release_version": "0.2.0",
  "product": "ticketry",
  "artifacts": {
    "frontend": {
      "command": ["npm", "run", "build"],
      "required_outputs": [
        "dist/index.html",
        "dist/ghostty-vt/ghostty-vt.wasm",
        "dist/ghostty-vt/LICENSE"
      ]
    },
    "tauri": {
      "command": ["npm", "run", "tauri", "--", "build"],
      "binary_name": "ticketry",
      "bundle_formats": ["app", "dmg", "app.tar.gz"]
    },
    "updater": {
      "archive_suffix": ".app.tar.gz",
      "signature_suffix": ".app.tar.gz.sig",
      "latest_manifest": {
        "filename": "latest.json",
        "format": "tauri-static-json-v2",
        "version_matches_release_version": true,
        "notes_required": true,
        "required_fields": [
          "version",
          "notes",
          "pub_date",
          "platforms.darwin-aarch64.signature",
          "platforms.darwin-aarch64.url"
        ]
      },
      "archive_policy": {
        "signed": true,
        "notarized": true
      },
      "signing": {
        "private_key_environment": "TAURI_SIGNING_PRIVATE_KEY",
        "private_key_password_environment": "TAURI_SIGNING_PRIVATE_KEY_PASSWORD",
        "distinct_from_apple_signing": true,
        "offline_backup_owner": "Ticketry release owner"
      }
    },
    "runtime_resources": [
      "src-tauri/tauri.conf.json",
      "src-tauri/capabilities/studio-main.json",
      "src-tauri/icons/icon.icns"
    ]
  },
  "release_policy": {
    "macos": {
      "signing": {
        "identity_environment": "APPLE_SIGNING_IDENTITY",
        "hardened_runtime": true,
        "entitlements": "src-tauri/entitlements.plist"
      },
      "notarization": {
        "required": true,
        "authentication": [
          "APPLE_ID,APPLE_PASSWORD,APPLE_TEAM_ID",
          "APPLE_API_KEY,APPLE_API_ISSUER,APPLE_API_KEY_PATH"
        ]
      }
    },
    "update": {
      "delivery": "in-app-user-initiated",
      "feed": {
        "repository": "ticketry-hq/ticketry-updates",
        "repository_visibility": "public",
        "channel": "stable",
        "latest_url": "https://github.com/ticketry-hq/ticketry-updates/releases/latest/download/latest.json"
      },
      "compatibility": [
        "app_version",
        "runtime_protocol",
        "database_schema",
        "signed",
        "notarized"
      ],
      "automatic_updates": false
    },
    "rollback": {
      "strategy": "retain-previous-launchable-app-until-post-install-acceptance",
      "recovery_document": "release/OPERATIONS.md"
    },
    "retention": {
      "previous_installer_versions": 2
    },
    "data": {
      "location": "platform-app-data-outside-installed-bundle",
      "uninstall": "preserve",
      "preserve": ["WorkTracker data", "preferences", "approved executable paths", "compatible agent login state"]
    }
  },
  "targets": [
    {
      "id": "macos-aarch64",
      "platform": "macos",
      "architecture": "aarch64",
      "build_architecture": "arm64",
      "rust_target": "aarch64-apple-darwin",
      "compatibility": {
        "minimum_os": "11.0",
        "tmux": "external-prerequisite",
        "runtime_protocol": "1",
        "database_schema": "forward-migrations-required",
        "app_version": "0.2.0"
      }
    }
  ]
}
