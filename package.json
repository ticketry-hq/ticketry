{
  "name": "worktracker-stack",
  "license": "MIT",
  "private": true,
  "version": "0.2.0",
  "workspaces": [
    "studio"
  ],
  "scripts": {
    "catalog:build": "npm --prefix docs/eventcatalog run build",
    "catalog:dev": "npm --prefix docs/eventcatalog run dev",
    "catalog:model": "npm --prefix docs/modelcatalog run dev",
    "catalog:model:build": "npm --prefix docs/modelcatalog run build",
    "catalog:model:preview": "npm --prefix docs/modelcatalog run preview",
    "catalog:preview": "npm --prefix docs/eventcatalog run preview",
    "catalog:sync": "npm --prefix docs/eventcatalog run sync",
    "dev": "npm run desktop:dev",
    "web": "node scripts/web-dev.mjs",
    "web:dev": "npm run web",
    "boundary:check": "node scripts/check-boundary.mjs",
    "caller:check": "node scripts/shipping-caller-gate.mjs",
    "desktop:build": "npm run desktop:build --workspace @worktracker/studio",
    "desktop:deploy": "npm run desktop:deploy --workspace @worktracker/studio",
    "deploy": "npm run desktop:deploy --workspace @worktracker/studio",
    "desktop:dev": "npm run desktop:dev --workspace @worktracker/studio --",
    "desktop:dev:seeded": "npm run desktop:dev -- --seed-from-product",
    "desktop:smoke": "npm run desktop:smoke --workspace @worktracker/studio",
    "desktop:smoke:concurrent": "npm run desktop:smoke:concurrent --workspace @worktracker/studio",
    "desktop:smoke:dev": "npm run desktop:smoke:dev --workspace @worktracker/studio",
    "desktop:smoke:packaged": "npm run desktop:smoke:packaged --workspace @worktracker/studio",
    "logs": "node scripts/dev-logs.mjs show",
    "logs:path": "node scripts/dev-logs.mjs path",
    "logs:follow": "node scripts/dev-logs.mjs follow",
    "logs:clear": "node scripts/dev-logs.mjs clear",
    "serve:dmg": "node scripts/serve-dmg.mjs",
    "verify:slice5-copy": "cargo run --locked --manifest-path studio/src-tauri/Cargo.toml --features development-tools --bin verify_slice5_copy --",
    "verify:slice6-copy": "cargo run --locked --manifest-path studio/src-tauri/Cargo.toml --features development-tools --bin verify_slice6_copy --",
    "typecheck": "npm run typecheck --workspace @worktracker/studio",
    "build": "npm run build --workspace @worktracker/studio"
  }
}
