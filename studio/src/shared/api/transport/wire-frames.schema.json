{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "description": "Generated by `manage.py export_wire_frames` from terminals/frames.py. Do not edit by hand.",
  "oneOf": [
    {
      "description": "Client → server: spawn a fresh agent terminal (``mode:\"spawn\"``).",
      "properties": {
        "agent": {
          "enum": [
            "claude",
            "agy",
            "codex",
            "gemini"
          ],
          "title": "Agent",
          "type": "string"
        },
        "cols": {
          "title": "Cols",
          "type": "integer"
        },
        "doc_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Doc Id"
        },
        "doc_rel_path": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Doc Rel Path"
        },
        "initial_prompt": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Initial Prompt"
        },
        "instant_prompt": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Instant Prompt"
        },
        "is_doc_chat": {
          "title": "Is Doc Chat",
          "type": "boolean"
        },
        "is_instant": {
          "title": "Is Instant",
          "type": "boolean"
        },
        "is_planning": {
          "title": "Is Planning",
          "type": "boolean"
        },
        "mode": {
          "const": "spawn",
          "title": "Mode",
          "type": "string"
        },
        "module_id": {
          "title": "Module Id",
          "type": "string"
        },
        "project_id": {
          "title": "Project Id",
          "type": "string"
        },
        "rows": {
          "title": "Rows",
          "type": "integer"
        },
        "task_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Task Id"
        },
        "type": {
          "const": "init",
          "title": "Type",
          "type": "string"
        }
      },
      "required": [
        "type",
        "mode",
        "agent",
        "project_id",
        "module_id",
        "task_id",
        "initial_prompt",
        "cols",
        "rows",
        "is_planning",
        "is_instant",
        "instant_prompt",
        "is_doc_chat",
        "doc_rel_path",
        "doc_id"
      ],
      "title": "InitSpawnFrame",
      "type": "object"
    },
    {
      "description": "Client → server: attach to a durable terminal (``mode:\"attach\"``).",
      "properties": {
        "agent_run_id": {
          "title": "Agent Run Id",
          "type": "string"
        },
        "cols": {
          "title": "Cols",
          "type": "integer"
        },
        "mode": {
          "const": "attach",
          "title": "Mode",
          "type": "string"
        },
        "rows": {
          "title": "Rows",
          "type": "integer"
        },
        "type": {
          "const": "init",
          "title": "Type",
          "type": "string"
        }
      },
      "required": [
        "type",
        "mode",
        "agent_run_id",
        "cols",
        "rows"
      ],
      "title": "InitAttachFrame",
      "type": "object"
    },
    {
      "description": "Server → client: the session is live and streaming.",
      "properties": {
        "agent_run_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Agent Run Id"
        },
        "session_id": {
          "title": "Session Id",
          "type": "string"
        },
        "type": {
          "const": "ready",
          "title": "Type",
          "type": "string"
        }
      },
      "required": [
        "type",
        "session_id"
      ],
      "title": "ReadyFrame",
      "type": "object"
    },
    {
      "description": "Client → server: terminal geometry changed.",
      "properties": {
        "cols": {
          "title": "Cols",
          "type": "integer"
        },
        "rows": {
          "title": "Rows",
          "type": "integer"
        },
        "type": {
          "const": "resize",
          "title": "Type",
          "type": "string"
        }
      },
      "required": [
        "type",
        "cols",
        "rows"
      ],
      "title": "ResizeFrame",
      "type": "object"
    },
    {
      "description": "Client → server: wheel/trackpad scroll bridged to tmux copy-mode (#578).",
      "properties": {
        "dir": {
          "enum": [
            "up",
            "down"
          ],
          "title": "Dir",
          "type": "string"
        },
        "lines": {
          "title": "Lines",
          "type": "integer"
        },
        "type": {
          "const": "scroll",
          "title": "Type",
          "type": "string"
        }
      },
      "required": [
        "type",
        "dir",
        "lines"
      ],
      "title": "ScrollFrame",
      "type": "object"
    },
    {
      "description": "Server → client: a terminal error before/at close.",
      "properties": {
        "message": {
          "title": "Message",
          "type": "string"
        },
        "type": {
          "const": "error",
          "title": "Type",
          "type": "string"
        }
      },
      "required": [
        "type",
        "message"
      ],
      "title": "ErrorFrame",
      "type": "object"
    }
  ],
  "title": "Terminal WebSocket wire frames"
}
