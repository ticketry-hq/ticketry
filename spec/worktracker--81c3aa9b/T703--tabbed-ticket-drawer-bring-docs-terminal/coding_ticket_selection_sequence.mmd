sequenceDiagram
  actor User
  participant Gate as BootstrapGate
  participant Config as coding configStore
  participant Tasks as tasksStore
  participant Workspace as TicketWorkspace
  participant Docs as Documents API
  participant Terms as terminalStore
  participant TermAPI as Terminals API
  participant Host as TerminalHost

  Gate->>Config: loadConfig()
  Config->>Config: selectProfile(recent or 0)
  Config->>Tasks: loadProjects()
  Tasks->>Tasks: selectProject(recent_project_id)
  Tasks->>Tasks: selectModule(recent_module_ids[project])
  User->>Tasks: selectTask(taskId)
  Tasks->>Terms: fetchPersistedSessions(taskId)
  Tasks->>Tasks: loadDetails(projectId, taskId)
  Workspace->>Docs: getDocuments(taskId, projectId, moduleId)
  Docs-->>Workspace: discovered docs
  Workspace->>Workspace: hydrateDocs(bucket=taskId)
  Terms->>TermAPI: getTerminals(taskId)
  TermAPI-->>Terms: persisted sessions
  Terms->>Terms: restoreLiveSessions(taskId)
  Workspace->>Host: visible session id from active tab/doc overlay
