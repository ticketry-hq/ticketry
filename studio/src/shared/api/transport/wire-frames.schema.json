{
  "$defs": {
    "RunRecord": {
      "description": "Transport-neutral status facts for one durable agent run.\n\nTwo axes travel together but are ordered independently: the provider\nlifecycle (``state``/``updated_at``, ordered by lifecycle timestamp) and\nterminal output activity (``output_sequence``/``last_output_at``, ordered\nby the monotonic per-session sequence). Neither timestamp may be used to\ndecide the validity of the other axis.",
      "properties": {
        "agent": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Agent"
        },
        "agent_run_id": {
          "title": "Agent Run Id",
          "type": "string"
        },
        "effective_state": {
          "anyOf": [
            {
              "enum": [
                "starting",
                "working",
                "needs_input",
                "permission_required",
                "turn_complete",
                "quiet",
                "reconnecting",
                "stalled",
                "exited",
                "error",
                "unknown"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Effective State"
        },
        "exit_code": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Exit Code"
        },
        "last_output_at": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Last Output At"
        },
        "launch_model": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Launch Model"
        },
        "launch_state": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Launch State"
        },
        "module_id": {
          "title": "Module Id",
          "type": "string"
        },
        "output_sequence": {
          "default": 0,
          "title": "Output Sequence",
          "type": "integer"
        },
        "project_id": {
          "title": "Project Id",
          "type": "string"
        },
        "scope": {
          "enum": [
            "task",
            "plan",
            "instant",
            "docchat",
            "shell"
          ],
          "title": "Scope",
          "type": "string"
        },
        "started_at": {
          "title": "Started At",
          "type": "string"
        },
        "state": {
          "enum": [
            "starting",
            "working",
            "needs_input",
            "permission_required",
            "turn_complete",
            "quiet",
            "reconnecting",
            "exited",
            "error",
            "unknown"
          ],
          "title": "State",
          "type": "string"
        },
        "task_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Task Id"
        },
        "updated_at": {
          "title": "Updated At",
          "type": "string"
        }
      },
      "required": [
        "agent_run_id",
        "project_id",
        "task_id",
        "module_id",
        "scope",
        "started_at",
        "state",
        "updated_at"
      ],
      "title": "RunRecord",
      "type": "object"
    }
  },
  "$schema": "http://json-schema.org/draft-07/schema#",
  "description": "Generated by `manage.py export_wire_frames` from terminals/frames.py. Do not edit by hand.",
  "oneOf": [
    {
      "description": "Client → server: spawn a fresh agent terminal (``mode:\"spawn\"``).",
      "properties": {
        "agent": {
          "enum": [
            "claude",
            "agy",
            "codex",
            "gemini"
          ],
          "title": "Agent",
          "type": "string"
        },
        "cols": {
          "title": "Cols",
          "type": "integer"
        },
        "doc_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Doc Id"
        },
        "doc_rel_path": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Doc Rel Path"
        },
        "initial_prompt": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Initial Prompt"
        },
        "instant_prompt": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Instant Prompt"
        },
        "is_doc_chat": {
          "title": "Is Doc Chat",
          "type": "boolean"
        },
        "is_instant": {
          "title": "Is Instant",
          "type": "boolean"
        },
        "is_planning": {
          "title": "Is Planning",
          "type": "boolean"
        },
        "mode": {
          "const": "spawn",
          "title": "Mode",
          "type": "string"
        },
        "module_id": {
          "title": "Module Id",
          "type": "string"
        },
        "project_id": {
          "title": "Project Id",
          "type": "string"
        },
        "rows": {
          "title": "Rows",
          "type": "integer"
        },
        "task_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Task Id"
        },
        "type": {
          "const": "init",
          "title": "Type",
          "type": "string"
        }
      },
      "required": [
        "type",
        "mode",
        "agent",
        "project_id",
        "module_id",
        "task_id",
        "initial_prompt",
        "cols",
        "rows",
        "is_planning",
        "is_instant",
        "instant_prompt",
        "is_doc_chat",
        "doc_rel_path",
        "doc_id"
      ],
      "title": "InitSpawnFrame",
      "type": "object"
    },
    {
      "description": "Client → server: attach to a durable terminal (``mode:\"attach\"``).",
      "properties": {
        "agent_run_id": {
          "title": "Agent Run Id",
          "type": "string"
        },
        "cols": {
          "title": "Cols",
          "type": "integer"
        },
        "mode": {
          "const": "attach",
          "title": "Mode",
          "type": "string"
        },
        "rows": {
          "title": "Rows",
          "type": "integer"
        },
        "type": {
          "const": "init",
          "title": "Type",
          "type": "string"
        }
      },
      "required": [
        "type",
        "mode",
        "agent_run_id",
        "cols",
        "rows"
      ],
      "title": "InitAttachFrame",
      "type": "object"
    },
    {
      "description": "Server → client: the session is live and streaming.",
      "properties": {
        "agent_run_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Agent Run Id"
        },
        "session_id": {
          "title": "Session Id",
          "type": "string"
        },
        "type": {
          "const": "ready",
          "title": "Type",
          "type": "string"
        }
      },
      "required": [
        "type",
        "session_id"
      ],
      "title": "ReadyFrame",
      "type": "object"
    },
    {
      "description": "Client → server: terminal geometry changed.",
      "properties": {
        "cols": {
          "title": "Cols",
          "type": "integer"
        },
        "rows": {
          "title": "Rows",
          "type": "integer"
        },
        "type": {
          "const": "resize",
          "title": "Type",
          "type": "string"
        }
      },
      "required": [
        "type",
        "cols",
        "rows"
      ],
      "title": "ResizeFrame",
      "type": "object"
    },
    {
      "description": "Client → server: wheel/trackpad scroll bridged to tmux copy-mode (#578).",
      "properties": {
        "dir": {
          "enum": [
            "up",
            "down"
          ],
          "title": "Dir",
          "type": "string"
        },
        "lines": {
          "title": "Lines",
          "type": "integer"
        },
        "type": {
          "const": "scroll",
          "title": "Type",
          "type": "string"
        }
      },
      "required": [
        "type",
        "dir",
        "lines"
      ],
      "title": "ScrollFrame",
      "type": "object"
    },
    {
      "description": "Server → client: a terminal error before/at close.",
      "properties": {
        "message": {
          "title": "Message",
          "type": "string"
        },
        "type": {
          "const": "error",
          "title": "Type",
          "type": "string"
        }
      },
      "required": [
        "type",
        "message"
      ],
      "title": "ErrorFrame",
      "type": "object"
    }
  ],
  "title": "Terminal WebSocket wire frames"
}
