graph LR
  subgraph Studio["Studio work-item surfaces"]
    Normal["Header / empty / shortcut create"]
    Inline["Backlog inline + pane create"]
    AddUnder["Epic add-under"]
    Board["Board column + swimlane create"]
    MapSprint["Story Map / sprint context"]
  end

  subgraph Target["Target resolution"]
    Resolver["createTargetResolver"]
    Picker["SingleEpicPickerModal"]
    Context["createPromptContext"]
  end

  subgraph Shared["Shared terminal-create flow"]
    Launcher["launchTerminalCreate"]
    FlowStore["terminalCreateStore"]
    Prompt["TerminalCreatePromptDialog"]
    Agent["TerminalCreateAgentPicker"]
  end

  subgraph Runtime["Existing terminal runtime"]
    TerminalStore["useTerminalStore.openSession"]
    Session["Scratch planning session"]
    StudioPanel["StudioScratchTerminalPanel"]
    CodingScratch["/coding scratch workspace"]
  end

  Normal --> Resolver
  Inline --> Resolver
  AddUnder --> Resolver
  Board --> Resolver
  MapSprint --> Resolver
  Resolver -->|none or many epics| Picker
  Resolver -->|one epic/module| Context
  Picker --> Context
  Context --> Launcher
  Launcher --> FlowStore
  FlowStore --> Prompt
  Prompt --> Agent
  Launcher -->|typed prompt present| Agent
  Agent --> TerminalStore
  TerminalStore --> Session
  Session --> StudioPanel
  Session --> CodingScratch
