sequenceDiagram
  actor User
  participant Router as React Router
  participant RouteSync as useRouteSync
  participant Studio as studioStore
  participant UI as uiStore
  participant Drawer as IssueDrawerHost
  participant Issue as issueStore
  participant API as WorkTracker API
  participant Backlog as backlogStore

  User->>Router: Open /issues/:key
  Router->>RouteSync: params.key is present
  RouteSync->>UI: openDrawer(key)
  RouteSync-->>Studio: leave activeView unchanged
  UI->>Drawer: drawerKey changes
  Drawer->>Issue: openIssue(key)
  Issue->>API: getWorkItem(key)
  API-->>Issue: WorkItemDetail
  Issue->>Studio: selectProject(detail.task.project_id)
  Issue->>Backlog: loadBacklog(project_id) if cold
  Issue->>API: listProjectWorkItems(parent=issue.id)
  API-->>Issue: child issues
  Issue-->>Drawer: render IssueDetail
