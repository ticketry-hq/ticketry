{
  "name": "worktracker-stack",
  "license": "MIT",
  "private": true,
  "version": "0.2.0",
  "packageManager": "bun@1.4.2",
  "workspaces": [
    "studio"
  ],
  "scripts": {
    "catalog:build": "bun run --cwd docs/eventcatalog build",
    "catalog:dev": "bun run --cwd docs/eventcatalog dev",
    "catalog:model": "bun run --cwd docs/modelcatalog dev",
    "catalog:model:build": "bun run --cwd docs/modelcatalog build",
    "catalog:model:preview": "bun run --cwd docs/modelcatalog preview",
    "catalog:preview": "bun run --cwd docs/eventcatalog preview",
    "catalog:sync": "bun run --cwd docs/eventcatalog sync",
    "dev": "bun run desktop:dev",
    "web": "bun scripts/web-dev.mjs",
    "web:dev": "bun scripts/web-dev.mjs --development-profile",
    "boundary:check": "node scripts/check-boundary.mjs",
    "caller:check": "node scripts/shipping-caller-gate.mjs",
    "desktop:build": "bun run --cwd studio desktop:build",
    "desktop:deploy": "bun run --cwd studio desktop:deploy",
    "deploy": "bun run --cwd studio desktop:deploy",
    "desktop:dev": "bun run --cwd studio desktop:dev",
    "desktop:dev:prod": "bun run --cwd studio desktop:dev --production-data",
    "desktop:smoke": "bun run --cwd studio desktop:smoke",
    "desktop:smoke:concurrent": "bun run --cwd studio desktop:smoke:concurrent",
    "desktop:smoke:dev": "bun run --cwd studio desktop:smoke:dev",
    "desktop:smoke:packaged": "bun run --cwd studio desktop:smoke:packaged",
    "logs": "node scripts/dev-logs.mjs show",
    "logs:path": "node scripts/dev-logs.mjs path",
    "logs:follow": "node scripts/dev-logs.mjs follow",
    "logs:clear": "node scripts/dev-logs.mjs clear",
    "logs:trace": "node scripts/dev-logs.mjs trace",
    "logs:startup": "node scripts/dev-logs.mjs startup",
    "logs:test": "node --test scripts/dev-logs.test.mjs scripts/launch-trace-report.test.mjs scripts/launch-trace-harness-report.test.mjs scripts/startup-trace-report.test.mjs scripts/startup-trace-regression.test.mjs",
    "serve:dmg": "node scripts/serve-dmg.mjs",
    "verify:slice5-copy": "cargo run --locked --manifest-path studio/src-tauri/Cargo.toml -p ticketry-dev-tools --bin verify_slice5_copy --",
    "verify:slice6-copy": "cargo run --locked --manifest-path studio/src-tauri/Cargo.toml -p ticketry-dev-tools --bin verify_slice6_copy --",
    "typecheck": "bun run --cwd studio typecheck",
    "build": "bun run --cwd studio build",
    "perf:prepare": "bun run --cwd studio perf:prepare",
    "perf:run": "bun run --cwd studio perf:run",
    "perf:desktop": "bun run --cwd studio perf:desktop",
    "perf:compare": "bun run --cwd studio perf:compare",
    "perf:webcontent": "bun run --cwd studio perf:webcontent",
    "perf:webcontent:packaged": "bun run --cwd studio perf:webcontent:packaged",
    "perf:verify": "bun run --cwd studio perf:verify",
    "perf:test": "bun run --cwd studio perf:test",
    "perf:typecheck": "bun run --cwd studio perf:typecheck"
  }
}
