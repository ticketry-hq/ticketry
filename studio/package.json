{
  "name": "@worktracker/studio",
  "license": "MIT",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "libghostty:prepare": "sh scripts/prepare-libghostty.sh",
    "predesktop:build": "npm run libghostty:prepare",
    "predesktop:dev": "npm run libghostty:prepare",
    "prerelease:build": "npm run libghostty:prepare",
    "desktop:build": "node scripts/release-build.mjs",
    "desktop:deploy": "node scripts/desktop-deploy.mjs",
    "desktop:dev": "node scripts/desktop-dev.mjs",
    "release:build": "node scripts/release-build.mjs",
    "release:validate": "node scripts/release-build.mjs --validate",
    "release:test": "node --test scripts/release-build.test.mjs scripts/desktop-deploy.test.mjs scripts/installed-artifact-acceptance.test.mjs scripts/installed-artifact-acceptance-driver.test.mjs scripts/release-publish.test.mjs",
    "release:acceptance": "node scripts/installed-artifact-acceptance.mjs",
    "release:publish": "node scripts/release-publish.mjs",
    "desktop:smoke": "vitest run src/test/desktopShellContract.test.ts && node --test scripts/desktop-concurrent-smoke.test.mjs && node scripts/desktop-smoke.mjs && cargo test --manifest-path src-tauri/Cargo.toml",
    "desktop:smoke:concurrent": "node --test scripts/desktop-concurrent-smoke.test.mjs",
    "desktop:smoke:dev": "node scripts/desktop-smoke.mjs dev",
    "desktop:smoke:packaged": "node scripts/desktop-smoke.mjs packaged",
    "test:native-clipboard": "sh scripts/test-native-clipboard.sh",
    "build": "npm run lint:client-store && tsc --noEmit && vite build",
    "lint:client-store": "eslint src/state",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:e2e:overhaul": "playwright test e2e/overhaul.spec.ts",
    "test:overhaul": "vitest run src/test/overhaul*Acceptance.test.tsx src/test/studioRenameBehaviour.test.tsx",
    "test:watch": "vitest",
    "tauri": "tauri"
  },
  "dependencies": {
    "@codemirror/language": "6.12.4",
    "@codemirror/state": "6.7.1",
    "@codemirror/view": "6.43.9",
    "@fontsource-variable/hanken-grotesk": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@lezer/highlight": "1.2.3",
    "@mdxeditor/editor": "4.2.1",
    "@tanstack/react-query": "^5.102.2",
    "@tauri-apps/api": "^2.11.1",
    "@worktracker/typescript-sdk": "file:../surfaces/worktracker-typescript-sdk",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-web-links": "^0.12.0",
    "isomorphic-dompurify": "^3.22.0",
    "marked": "^18.0.10",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-resizable-panels": "^4.12.3",
    "turndown": "^7.2.4",
    "xterm": "^5.3.0",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@tailwindcss/typography": "^0.5.19",
    "@tauri-apps/cli": "^2.11.4",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.1.0",
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@types/turndown": "^5.0.6",
    "@typescript-eslint/parser": "^8.67.0",
    "@vitejs/plugin-react": "^6.1.0",
    "ajv": "^8.17.1",
    "autoprefixer": "^10.5.4",
    "eslint": "^10.9.0",
    "jsdom": "^30.0.1",
    "postcss": "^8.5.26",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.2.2",
    "vitest": "^4.1.11"
  }
}
