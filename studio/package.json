{
  "name": "@worktracker/studio",
  "license": "MIT",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "predev": "npm run ghostty-vt:prepare",
    "libghostty:prepare": "sh scripts/prepare-libghostty.sh",
    "ghostty-vt:prepare": "sh scripts/prepare-ghostty-vt-wasm.sh",
    "predesktop:build": "npm run ghostty-vt:prepare && npm run libghostty:prepare",
    "predesktop:dev": "npm run ghostty-vt:prepare && npm run libghostty:prepare",
    "prerelease:build": "npm run ghostty-vt:prepare && npm run libghostty:prepare",
    "desktop:build": "node scripts/release-build.mjs",
    "desktop:deploy": "node scripts/desktop-deploy.mjs",
    "desktop:dev": "node scripts/desktop-dev.mjs",
    "release:build": "node scripts/release-build.mjs",
    "release:validate": "node scripts/release-build.mjs --validate",
    "release:test": "node --test scripts/release-build.test.mjs scripts/desktop-deploy.test.mjs scripts/installed-artifact-acceptance.test.mjs scripts/installed-artifact-acceptance-driver.test.mjs scripts/release-publish.test.mjs scripts/public-update-publisher.test.mjs scripts/update-acceptance.test.mjs scripts/update-acceptance-driver.test.mjs",
    "release:acceptance": "node scripts/installed-artifact-acceptance.mjs",
    "release:acceptance:update": "node scripts/update-acceptance.mjs",
    "release:publish": "node scripts/release-publish.mjs",
    "release:publish:update": "node scripts/public-update-publisher.mjs",
    "desktop:smoke": "vitest run src/test/desktopShellContract.test.ts && node --test scripts/desktop-concurrent-smoke.test.mjs && node scripts/desktop-smoke.mjs && cargo test --manifest-path src-tauri/Cargo.toml",
    "desktop:smoke:concurrent": "node --test scripts/desktop-concurrent-smoke.test.mjs",
    "desktop:smoke:dev": "node scripts/desktop-smoke.mjs dev",
    "desktop:smoke:packaged": "node scripts/desktop-smoke.mjs packaged",
    "test:native-ghostty-command-routing": "sh scripts/test-native-ghostty-command-routing.sh",
    "test:native-ghostty-studio-chords": "sh scripts/test-native-ghostty-studio-chords.sh",
    "test:native-ghostty-webview-composition": "sh scripts/test-native-ghostty-webview-composition.sh",
    "measure:native-ghostty-retention": "node scripts/native-view-resource-measurement.mjs",
    "measure:native-ghostty-retention:packaged": "node scripts/native-view-retention-benchmark.mjs",
    "build": "npm run lint:client-store && tsc --noEmit && vite build",
    "prebuild": "npm run ghostty-vt:prepare",
    "lint:client-store": "eslint src/state",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:e2e:desktop": "node scripts/desktop-agent-acceptance.mjs",
    "test:e2e:overhaul": "playwright test e2e/overhaul.spec.ts",
    "test:overhaul": "vitest run src/test/overhaul*Acceptance.test.tsx src/test/studioRenameBehaviour.test.tsx",
    "test:watch": "vitest",
    "graphql:generate": "node scripts/generate-graphql-foundation.mjs",
    "graphql:drift": "node scripts/verify-generated.mjs",
    "tauri": "tauri"
  },
  "dependencies": {
    "@apollo/client": "^4.2.12",
    "@codemirror/language": "6.12.4",
    "@codemirror/state": "6.7.1",
    "@codemirror/view": "6.43.6",
    "@fontsource-variable/hanken-grotesk": "^5.2.8",
    "@fontsource-variable/jetbrains-mono": "^5.2.8",
    "@graphql-typed-document-node/core": "^3.2.0",
    "@lezer/highlight": "1.2.3",
    "@mdxeditor/editor": "4.1.0",
    "@tauri-apps/api": "^2.11.1",
    "@xterm/addon-fit": "^0.10.0",
    "@xterm/addon-web-links": "^0.11.0",
    "graphql": "^17.0.2",
    "isomorphic-dompurify": "^3.14.0",
    "marked": "^18.0.5",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-resizable-panels": "^2.1.7",
    "react-router-dom": "^6.26.2",
    "rxjs": "^7.8.2",
    "turndown": "^7.2.4",
    "xterm": "^5.3.0"
  },
  "devDependencies": {
    "@graphql-codegen/cli": "^7.3.1",
    "@graphql-codegen/typed-document-node": "^7.1.0",
    "@graphql-codegen/typescript": "^6.1.0",
    "@graphql-codegen/typescript-operations": "^6.1.6",
    "@playwright/test": "^1.62.1",
    "@tailwindcss/typography": "^0.5.19",
    "@tauri-apps/cli": "^2.11.4",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.1.0",
    "@types/node": "^22.10.2",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@types/turndown": "^5.0.6",
    "@typescript-eslint/parser": "^8.66.0",
    "@vitejs/plugin-react": "^4.3.1",
    "ajv": "^8.17.1",
    "autoprefixer": "^10.4.20",
    "eslint": "^10.8.0",
    "jsdom": "^25.0.1",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.4.5",
    "vite": "^5.3.1",
    "vitest": "^2.1.8",
    "webdriverio": "^9.31.2"
  }
}
