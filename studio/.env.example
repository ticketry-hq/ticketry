# WorkTracker Studio — copy to .env.local and fill in. .env* is gitignored.

# Base URL for the worktracker API. Optional: defaults to /api/work-tracker,
# which the dev proxy (vite.config.ts) forwards to the backend same-origin.
# Set an absolute URL to point at a remote backend in other environments.
VITE_WT_API_BASE=/api/work-tracker

# The worktracker x-api-key token (matches the backend's WORKTRACKER_API_TOKEN).
VITE_WT_API_KEY=

# Agent-runtime API root. Optional: defaults to /api, which the dev proxy
# forwards same-origin.
VITE_AGENT_API_BASE=/api
