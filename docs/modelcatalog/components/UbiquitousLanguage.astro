---
import languageGroups from './language.generated.json';

const termCount = languageGroups.reduce((sum, group) => sum + group.terms.length, 0);

const modelLinks = {
  'workflow-state': '#model-state',
  'workflow-state-color': '#model-state',
  'transition-gate': '#model-issue-type-transition',
  'work-item-workflow': '#model-issue-type-transition',
  'work-item-order': '#model-issue',
  'review-finding': '#model-issue',
  'finding-source-location': '#model-issue',
  'dependency-subtree-status-read': '#model-issue',
  'per-type-transition-map': '#model-issue-type-transition',
  'workflow-member-state': '#model-state',
  'workflow-prune': '#model-issue-type-transition',
  'transition-origin': '#model-issue-type-transition',
  'human-only-transition': '#model-issue-type-transition',
  'state-entry-auto-start': '#model-launch-binding',
  'work-item-change-revision': '#model-issue',
  'work-item-change-frame': '#store-backlog-store',
  'subtree-run-capability': '#model-launch-binding',
  'graph-run': '#model-graph-run',
  'durable-node-fact': '#model-engine-run',
  'ready-set': '#model-engine-run',
  'dependency-halt': '#model-engine-run',
  'graph-reset': '#model-engine-run',
  'workflow-prompt-binding': '#model-launch-binding',
  'workflow-launch-configuration': '#model-launch-binding',
  'automated-launch-attempt': '#model-automation-attempt',
  'automation-gate': '#model-issue-type-transition',
  'pathfind': '#model-issue-type',
  'implementation': '#model-issue-type',
  'story': '#model-issue-type',
  'task-launch-flow': '#store-terminal-store',
  'scratch-workspace': '#store-terminal-store',
  'scratch-launch-flow': '#store-terminal-store',
  'module-scratch-workspace': '#store-terminal-store',
  'task-workspace': '#store-drawer-workspace-store',
  'focused-pane': '#store-ui-store',
  'subtree-lifecycle-chicklets': '#store-agent-status-store',
  'automation-failure-chicklet': '#store-agent-status-store',
  'module-task-tree': '#store-tasks-store',
  'workflow-graph-view': '#store-workflow-editor-store',
  'state-attribute-panel': '#store-workflow-editor-store',
  'document-revision-digest': '#model-design-document',
  'stale-save-conflict': '#model-design-document',
  'sidecar': '#data-model',
  'supervised-pair': '#data-model',
  'owned-backend': '#data-model',
  'service-health': '#data-model',
};

const linkFor = (term) => modelLinks[term.id] ?? '#data-model';
---

<section id="ubiquitous-language" class="not-prose scroll-mt-20 mt-16">
  <div class="pb-6 border-b border-[rgb(var(--ec-page-border))]">
    <div class="flex flex-wrap items-center gap-2 text-xs font-semibold uppercase tracking-[0.16em] text-[rgb(var(--ec-accent))]">
      <span>Ubiquitous language</span>
      <span class="rounded-full border border-[rgb(var(--ec-page-border))] px-2 py-1 normal-case tracking-normal text-[rgb(var(--ec-page-text-muted))]">
        {termCount} terms · {languageGroups.length} contexts
      </span>
    </div>
    <h2 class="mt-3 text-3xl font-bold text-[rgb(var(--ec-page-text))]">
      The words Ticketry means precisely
    </h2>
    <p class="mt-3 max-w-4xl text-[rgb(var(--ec-page-text-muted))] font-light">
      These terms are generated from the repository’s context glossaries. Every card links back
      to the closest durable model or frontend projection; terms without a stored representation
      return to the model boundary.
    </p>
    <a href="#data-model" class="inline-flex mt-4 text-sm font-medium text-[rgb(var(--ec-accent))] hover:underline">
      ← Back to the full data model
    </a>
  </div>

  <div class="mt-8 space-y-8">
    {languageGroups.map((group) => (
      <section id={`language-${group.id}`} class="scroll-mt-24">
        <div class="flex flex-wrap items-end justify-between gap-2 mb-3">
          <div>
            <h3 class="text-xl font-semibold text-[rgb(var(--ec-page-text))]">{group.name}</h3>
            <code class="text-xs text-[rgb(var(--ec-page-text-muted))]">{group.source}</code>
          </div>
          <span class="text-xs text-[rgb(var(--ec-page-text-muted))]">{group.terms.length} terms</span>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 xl:grid-cols-3 gap-3">
          {group.terms.map((term) => (
            <a
              href={linkFor(term)}
              class="group rounded-xl border border-[rgb(var(--ec-page-border))] bg-[rgb(var(--ec-card-bg,var(--ec-page-bg)))] p-4 hover:border-[rgb(var(--ec-accent)/0.55)] hover:-translate-y-0.5 transition-all"
            >
              <div class="flex items-start justify-between gap-3">
                <div class="font-semibold text-[rgb(var(--ec-page-text))]">
                  {term.name}
                  {term.qualifier && <span class="ml-1 font-normal text-xs text-[rgb(var(--ec-page-text-muted))]">({term.qualifier})</span>}
                </div>
                <span class="shrink-0 text-xs text-[rgb(var(--ec-accent))] opacity-70 group-hover:opacity-100">↖ model</span>
              </div>
              <p class="mt-2 text-sm leading-6 text-[rgb(var(--ec-page-text-muted))]">{term.definition}</p>
              {term.avoid && (
                <p class="mt-3 pt-3 border-t border-[rgb(var(--ec-page-border))] text-xs text-[rgb(var(--ec-page-text-muted))]">
                  <span class="font-semibold text-amber-600 dark:text-amber-400">Avoid:</span> {term.avoid}
                </p>
              )}
            </a>
          ))}
        </div>
      </section>
    ))}
  </div>
</section>
