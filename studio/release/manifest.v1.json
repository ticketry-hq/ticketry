{
  "schema_version": 1,
  "release_version": "0.2.0",
  "product": "ticketry",
  "artifacts": {
    "frontend": {
      "command": ["npm", "run", "build"],
      "required_outputs": ["dist/index.html"]
    },
    "tauri": {
      "command": ["npm", "run", "tauri", "--", "build", "--features", "native-libghostty"],
      "binary_name": "ticketry",
      "bundle_formats": ["app", "dmg"]
    },
    "runtime_resources": [
      "src-tauri/tauri.conf.json",
      "src-tauri/capabilities/studio-main.json",
      "src-tauri/icons/icon.icns"
    ]
  },
  "release_policy": {
    "macos": {
      "signing": {
        "identity_environment": "APPLE_SIGNING_IDENTITY",
        "hardened_runtime": true,
        "entitlements": "src-tauri/entitlements.plist"
      },
      "notarization": {
        "required": true,
        "authentication": [
          "APPLE_ID,APPLE_PASSWORD,APPLE_TEAM_ID",
          "APPLE_API_KEY,APPLE_API_ISSUER,APPLE_API_KEY_PATH"
        ]
      }
    },
    "update": {
      "delivery": "verified-manual-installer",
      "compatibility": [
        "app_version",
        "runtime_protocol",
        "database_schema",
        "signed",
        "notarized"
      ],
      "automatic_updates": false
    },
    "rollback": {
      "strategy": "retain-previous-launchable-app-until-post-install-acceptance",
      "recovery_document": "release/OPERATIONS.md"
    },
    "retention": {
      "previous_installer_versions": 2
    },
    "data": {
      "location": "platform-app-data-outside-installed-bundle",
      "uninstall": "preserve",
      "preserve": ["WorkTracker data", "preferences", "approved executable paths", "compatible agent login state"]
    }
  },
  "targets": [
    {
      "id": "macos-aarch64",
      "platform": "macos",
      "architecture": "aarch64",
      "build_architecture": "arm64",
      "rust_target": "aarch64-apple-darwin",
      "compatibility": {
        "minimum_os": "11.0",
        "tmux": "external-prerequisite",
        "runtime_protocol": "1",
        "database_schema": "forward-migrations-required",
        "app_version": "0.2.0"
      }
    }
  ]
}
