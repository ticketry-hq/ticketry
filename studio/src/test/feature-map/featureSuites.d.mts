export interface FeatureSuiteViolation { rule: number; path: string; message: string }
export interface SuiteCase { editionTags?: string[]; titlePath?: string[]; allTags?: string[]; grepTitlePath?: string[]; title: string | null; tags: string[]; ids: string[]; literalTitle: boolean; literalTags: boolean; insideDeclaration: boolean }
export interface ParsedFeatureSuite { path: string; declarations: { id: string | null; isolation: string; profile: string; topLevel: boolean }[]; cases: SuiteCase[]; forbiddenCalls: string[]; violations: FeatureSuiteViolation[] }
export interface FeatureEntry { id: string; path: string; editions?: string[] | null; editionProblems?: string[]; coreSubFeatures?: string[]; suiteLines: string[]; suite: { path: string | null; exclusion: string | null; reason: string | null } | null; suitePath: string | null; subFeatures: string[]; coverage: { columns: string[]; rows: { id: string; cells: string[] }[] }; isolation: string; profile: string; cases: SuiteCase[]; cellCitations: { subFeature: string; dimension: string; ids: string[] }[] }
export interface FeatureRegistry { features: FeatureEntry[]; suites: ParsedFeatureSuite[]; nonFeatureSpecs: { path: string; reason: string }[]; browserSpecs: string[] }
export function parseFeatureSuite(source: string, path: string): ParsedFeatureSuite;
export function deriveFeatureRegistry(mapDirectory: string, e2eDirectory: string, repositoryRoot: string): FeatureRegistry;
